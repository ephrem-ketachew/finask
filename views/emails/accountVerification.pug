extends baseEmail.pug

block content
  style.
    .content-block {
      padding: 20px 30px;
    }
    .title {
      font-size: 22px;
      font-weight: 600;
      color: #111;
      margin-bottom: 15px;
    }
    .code-box {
      background-color: #F0F4F8; 
      border-radius: 8px;
      padding: 15px 20px;
      text-align: center;
      margin: 25px auto;
      border-left: 5px solid #F5C518; 
    }
    .code-box .code {
      font-size: 32px;
      font-weight: 700;
      color: #2D63BC; 
      letter-spacing: 5px;
      font-family: 'Courier New', Courier, monospace;
    }
    .disclaimer {
      font-size: 14px;
      color: #666;
    }

  table(role='presentation', border='0', cellpadding='0', cellspacing='0')
    tbody
      tr
        td.content-block
          p.title Welcome to Finask!
          p Hi #{name},
          p Thank you for joining Finask. To complete your registration, please use the verification code below. This code is valid for 24 hours.

          .code-box
            div.code #{verificationCode}

          p.disclaimer If you did not sign up for a Finask account, please disregard this email.
