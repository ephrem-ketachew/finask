doctype html
html
  head
    meta(name='viewport', content='width=device-width')
    meta(http-equiv='Content-Type', content='text/html; charset=UTF-8')
    title= subject
    style.
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol';
        -webkit-font-smoothing: antialiased;
        font-size: 16px;
        line-height: 1.5;
        margin: 0;
        padding: 0;
        -ms-text-size-adjust: 100%;
        -webkit-text-size-adjust: 100%;
        background-color: #f4f7f6; 
      }
      .body {
        background-color: #f4f7f6;
        width: 100%;
        padding: 20px 0;
      }
      .container {
        display: block;
        margin: 0 auto !important;
        max-width: 580px;
        padding: 10px;
        width: 100%;
      }
      .content {
        box-sizing: border-box;
        display: block;
        margin: 0 auto;
        max-width: 580px;
        padding: 10px;
      }
      .main {
        background: #ffffff;
        border: 1px solid #e9e9e9;
        border-radius: 8px;
        width: 100%;
      }

      .header {
        padding: 20px 0;
        text-align: center;
        width: 100%;
      }
      .header img {
        height: 40px;
        width: auto;
      }
      .footer {
        clear: both;
        margin-top: 20px;
        text-align: center;
        width: 100%;
      }
      .footer p {
        color: #999999;
        font-size: 12px;
        text-align: center;
      }

      p {
        font-size: 16px;
        font-weight: normal;
        margin: 0 0 15px;
        color: #333;
      }
      a {
        color: #2D63BC; 
        text-decoration: underline;
      }

  body
    table.body(role='presentation', border='0', cellpadding='0', cellspacing='0')
      tbody
        tr
          td  
          td.container
            .header
              a(href="YOUR_WEBSITE_URL_HERE")
                img(src="https://res.cloudinary.com/dxhkryxzk/image/upload/v1757156624/Vector_1_u5opd1.png", alt="Finask Logo")
            
            table.main(role='presentation', border='0', cellpadding='0', cellspacing='0')
              tbody
                tr
                  td
                    block content
            
            .footer
              p Finask &copy; 2025. All Rights Reserved.
          td  

