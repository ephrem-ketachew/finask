{
  "name": "finask-api",
  "version": "1.0.0",
  "description": "Finask backend API for university guidance platform",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:prod": "cross-env NODE_ENV=production nodemon server.js",
    "dev": "nodemon server.js",
    "seed:content": "node seeds/seed-content.js",
    "seed:import": "node seeds/seeder.js --import",
    "seed:delete": "node seeds/seeder.js --delete",
    "seed:patch-ids": "node seeds/patch-ids.js",
    "seed:interests": "node seeds/seedInterests.js --import",
    "delete:interests": "node seeds/seedInterests.js --delete",
    "debug": "node --inspect server.js"
  },
  "author": "Ephrem Ketachew",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.0.1",
    "geolib": "^3.3.4",
    "google-auth-library": "^10.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "juice": "^11.0.1",
    "mongodb": "^6.18.0",
    "mongoose": "^8.16.4",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.5",
    "pug": "^3.0.3",
    "sharp": "^0.34.3",
    "slugify": "^1.6.6",
    "streamifier": "^0.1.1",
    "validator": "^13.15.15",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "cross-env": "^10.0.0",
    "nodemon": "^3.1.10"
  }
}
